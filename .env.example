# LeadOps Portal — Environment Variables
# Copy this file to .env and fill in real values.
# .env is git-ignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ---------------------------------------------------------------------------

# Owner connection used ONLY by migrations (pnpm db:migrate) and test setup.
# In development the docker-compose superuser is leadops.
# Example: postgresql://leadops:leadops_dev@localhost:5432/leadops
DATABASE_OWNER_URL=

# Application / test connection as the RLS-enforced runtime role.
# Runtime role does not own tables, is not superuser, and has no BYPASSRLS.
# Production example: postgresql://leadops_runtime:<password>@<host>:5432/leadops
# Test example:       postgresql://leadops_runtime_test:leadops_runtime_test_dev@localhost:5432/leadops_test
DATABASE_URL=

# Dedicated least-privilege worker connection. Do not reuse DATABASE_URL.
# Development: postgresql://leadops_worker:leadops_worker_dev@localhost:5432/leadops
# Test:        postgresql://leadops_worker_test:leadops_worker_test_dev@localhost:5432/leadops_test
WORKER_DATABASE_URL=
PG_BOSS_SCHEMA=pgboss

# 32-byte application master key encoded as exactly 64 hexadecimal characters.
LEADOPS_ENCRYPTION_KEY=

# Logging
# Minimum log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Health
# Port the web server listens on (default Next.js: 3000)
PORT=3000

# Worker
# Heartbeat interval in milliseconds
WORKER_HEARTBEAT_MS=30000
# Graceful shutdown timeout in milliseconds
WORKER_SHUTDOWN_TIMEOUT_MS=10000
OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_CONCURRENCY=4

# AI qualification
# Required by the worker. Use "fake" only for local development/tests;
# production startup rejects it.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# Optional OpenAI-compatible base URL. Leave empty for the default OpenAI API.
AI_BASE_URL=
# Pricing is required so the post-call cost budget is auditable.
AI_INPUT_USD_PER_MILLION_TOKENS=
AI_OUTPUT_USD_PER_MILLION_TOKENS=
AI_MAX_OUTPUT_TOKENS=500
AI_MAX_INPUT_LENGTH=10000
AI_MAX_COST_CENTS=1000
AI_TIMEOUT_MS=30000

# Better Auth
# Secret used to sign session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the web app, e.g. http://localhost:3000
BETTER_AUTH_URL=

# ---------------------------------------------------------------------------
# Email Provider (worker)
# ---------------------------------------------------------------------------
# Supported: fake (test/development only), resend (production)
EMAIL_PROVIDER=
# Resend configuration (required when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
RESEND_FROM=

# ---------------------------------------------------------------------------
# OpenTelemetry (optional)
# ---------------------------------------------------------------------------
# Set OTEL_ENABLED=true to enable telemetry export
OTEL_ENABLED=
# OTLP HTTP endpoint (required when OTEL_ENABLED=true in production)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# Alerting (required in staging/production worker)
# ---------------------------------------------------------------------------
# Alert webhook URL (HTTPS required). Used for production alerting.
ALERT_WEBHOOK_URL=
